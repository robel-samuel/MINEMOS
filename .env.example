# ──────────────────────────────────────────────────────────────────────────────
# MINEMOS — optional environment variables
#
# Copy this file to .env (or export the values in your shell). The .env file is
# listed in .gitignore and MUST NOT be committed.
#
# The canonical engine needs no variables and no external service. Everything
# below is optional.
# ──────────────────────────────────────────────────────────────────────────────

# Model cache and offline use.
# HF_HOME=/path/to/hf_cache
# TRANSFORMERS_OFFLINE=1
# CUDA_VISIBLE_DEVICES=-1

# ──────────────────────────────────────────────────────────────────────────────
# Retrieval profile
#
# legacy      canonical retrieval unless a backend is selected explicitly
# canonical   canonical retrieval only; Qdrant is never contacted
# production  Qdrant is the required backend and configuration is validated
# ──────────────────────────────────────────────────────────────────────────────

# MINEMOS_RETRIEVAL_MODE=canonical

# ──────────────────────────────────────────────────────────────────────────────
# Qdrant — optional derived retrieval index
#
# Qdrant accelerates candidate search. MINEMOS remains the memory authority:
# every hit is resolved against canonical state before it is returned.
# Use QDRANT_URL for a server. QDRANT_PATH is embedded mode, which the
# production profile rejects.
# ──────────────────────────────────────────────────────────────────────────────

# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# QDRANT_PATH=./qdrant-data
# QDRANT_COLLECTION=minemos_memory
# QDRANT_TENANT_ID=default
# QDRANT_TIMEOUT=5.0
# QDRANT_CANDIDATE_LIMIT=128
# QDRANT_BATCH_SIZE=256
# QDRANT_MAX_RETRIES=2
# QDRANT_RETRY_BACKOFF=0.25
# QDRANT_ON_DISK=false
# QDRANT_PAYLOAD_INDEXES=true
# QDRANT_HYBRID_FUSION=dense
# QDRANT_RRF_K=60
# QDRANT_RECREATE=false

# Only for a trusted private network. The production profile otherwise requires
# HTTPS and an API key for any non-loopback host.
# QDRANT_ALLOW_INSECURE=false