# ──────────────────────────────────────────────────────────────────────────────
# MINEMOS — Environment Variables Example
#
# Copy this file to .env and fill in values for your local environment.
# The .env file is listed in .gitignore and MUST NOT be committed.
#
# Most users do not need to set any of these variables.
# The system works without any API keys or external services.
# ──────────────────────────────────────────────────────────────────────────────

# Optional: Override Hugging Face model cache directory.
# Default: ~/.cache/huggingface
# Useful if your home directory has limited space and you want
# to store large model downloads elsewhere.
# HF_HOME=/path/to/hf_cache

# Optional: Force CPU-only execution (the code defaults to CPU already).
# Set to "1" to disable any GPU if accidentally detected.
# CUDA_VISIBLE_DEVICES=-1

# Optional: Restrict PyTorch thread count for reproducibility.
# Experiments use torch.set_num_threads(4) internally.
# OMP_NUM_THREADS=4

# Optional: Control Hugging Face offline mode.
# Set to "1" to prevent any network access (requires models pre-cached).
# TRANSFORMERS_OFFLINE=1

# ──────────────────────────────────────────────────────────────────────────────
# MINEMOS HTTP service (python -m minemos_service)
#
# All values below are placeholders. Never commit real keys, tokens or
# certificates. For local development, leave authentication unset and the
# service will refuse to start unless MINEMOS_DEV_INSECURE_NO_AUTH=1.
# See docs/guides/service.md and docs/guides/deployment.md.
# ──────────────────────────────────────────────────────────────────────────────

# MINEMOS_ENVIRONMENT=production
# MINEMOS_HOST=127.0.0.1
# MINEMOS_PORT=8080
# MINEMOS_DATA_DIR=/var/lib/minemos
# MINEMOS_CHECKPOINT_DIR=/var/lib/minemos/checkpoints
# MINEMOS_PROVENANCE_DIR=/var/lib/minemos/provenance

# API keys: prefer a file over an inline value. Both use the same JSON:
# {"keys": [
#   {"key_id": "reader-1", "key": "<placeholder>",
#    "tenant": "<tenant-id>", "roles": ["reader"]}
# ]}
# MINEMOS_API_KEYS_FILE=/etc/minemos/api-keys.json
# MINEMOS_API_KEYS='{"keys": [{"key_id": "reader-1", "key": "<placeholder>", "tenant": "<tenant-id>", "roles": ["reader"]}]}'

# TLS is required for any non-loopback host in production, unless
# MINEMOS_ALLOW_INSECURE_HTTP=true is set explicitly.
# MINEMOS_TLS_CERT_FILE=/etc/minemos/tls/server.crt
# MINEMOS_TLS_KEY_FILE=/etc/minemos/tls/server.key

# Retrieval: canonical | legacy | production
# production requires a server-mode Qdrant URL. Embedded mode is rejected.
# MINEMOS_RETRIEVAL_MODE=production
# MINEMOS_QDRANT_URL=https://qdrant.example.invalid:6333
# MINEMOS_QDRANT_API_KEY=<placeholder>
# MINEMOS_QDRANT_COLLECTION_PREFIX=minemos_memories
# MINEMOS_QDRANT_TIMEOUT=5.0

# Resource and request limits.
# MINEMOS_ENGINE_CAPACITY=10000
# MINEMOS_ENGINE_DIM=4096
# MINEMOS_MAX_BODY_BYTES=1048576
# MINEMOS_MAX_OBSERVATIONS_PER_REQUEST=256
# MINEMOS_MAX_OBJECT_CHARS=8192
# MINEMOS_MAX_QUERY_CHARS=4096
# MINEMOS_REQUEST_TIMEOUT=30.0
# MINEMOS_RATE_LIMIT_PER_MINUTE=600
# MINEMOS_RATE_LIMIT_BURST=100
# MINEMOS_PERSIST_AFTER_MUTATION=true
# MINEMOS_CREDENTIAL_POLICY=reject
# MINEMOS_LOG_LEVEL=INFO

# Development only: allow unauthenticated access. Never enable in production.
# MINEMOS_DEV_INSECURE_NO_AUTH=1
