# ──────────────────────────────────────────────────────────────────────────────
# MINEMOS / Black Hole Memory — Environment Variables Example
#
# Copy this file to .env and fill in values for your local environment.
# The .env file is listed in .gitignore and MUST NOT be committed.
#
# Most users do not need to set any of these variables.
# The system works without any API keys or external services.
# ──────────────────────────────────────────────────────────────────────────────

# Optional: Override Hugging Face model cache directory.
# Default: ~/.cache/huggingface
# Useful if your home directory has limited space and you want
# to store large model downloads elsewhere.
# HF_HOME=/path/to/hf_cache

# Optional: Force CPU-only execution (the code defaults to CPU already).
# Set to "1" to disable any GPU if accidentally detected.
# CUDA_VISIBLE_DEVICES=-1

# Optional: Restrict PyTorch thread count for reproducibility.
# Experiments use torch.set_num_threads(4) internally.
# OMP_NUM_THREADS=4

# Optional: Control Hugging Face offline mode.
# Set to "1" to prevent any network access (requires models pre-cached).
# TRANSFORMERS_OFFLINE=1
